# The contact form (app/api/contact/route.ts) sends every enquiry to BOTH
# email and WhatsApp. Copy this file to .env.local and fill in the values.
# If one channel is missing or fails, the other still delivers.

# --- Email (Resend) ---
# 1. Sign up at https://resend.com using the inbox that should receive enquiries.
# 2. Create an API key: Dashboard > API Keys > Create API Key (permission: Sending access).
RESEND_API_KEY=..
# Where enquiries are delivered. Until a domain is verified in Resend, this MUST be
# the email address you signed up to Resend with.
CONTACT_TO=sufyanjatts199@gmail.com
# Optional: once autoiris-installation.co.uk is verified in Resend, send from it.
# RESEND_FROM=Auto Iris Website <enquiries@autoiris-installation.co.uk>

# --- WhatsApp (CallMeBot) ---
# 1. Save +34 623 78 95 80 in your phone contacts (check https://www.callmebot.com/blog/free-api-whatsapp-messages/
#    in case the number has changed).
# 2. From the WhatsApp account that should receive enquiries, send it:
#    I allow callmebot to send me messages
# 3. Paste the API key it replies with below.
CALLMEBOT_APIKEY=your-callmebot-apikey
# Number that receives the messages, international format (defaults to the site phone number)
CALLMEBOT_PHONE=+447523521215
