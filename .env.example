# SMTP credentials for the contact form (app/api/contact/route.ts).
# Without these the form falls back to telling the visitor to call or email.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=info.autoiris@gmail.com
SMTP_PASS=your-app-password

# Optional overrides
# SMTP_FROM=no-reply@autoiris-installation.co.uk
# CONTACT_TO=info.autoiris@gmail.com
